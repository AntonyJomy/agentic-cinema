# Gemini / Google ADK (required)
# Get a key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-key-here
# ADK reads GOOGLE_API_KEY; if unset, agents bridge from GEMINI_API_KEY.
GOOGLE_API_KEY=your-key-here

# Parallel Search MCP (optional — higher rate limits; anonymous works)
# Get a key from https://platform.parallel.ai
PARALLEL_API_KEY=your-parallel-api-key-here

# Limit concurrent Gemini-heavy agent runs (specialists + risk scoring).
# Lower = fewer 503/high-demand errors; higher = faster runs.
# Default in code is 2 if unset.
PIPELINE_CONCURRENCY=1
# Legacy alias (used if PIPELINE_CONCURRENCY is unset):
# SPECIALIST_CONCURRENCY=2

# Gemini model for all agents (override if a model is overloaded).
# For newer AI Studio keys, Google currently requires gemini-3.6-flash.
GEMINI_MODEL=gemini-3.6-flash

# Runtime environment: development enables /docs; production disables it.
ENVIRONMENT=development

# Auth: development (optional Bearer; falls back to local DEV_USER) or firebase (required).
# Defaults to development when ENVIRONMENT=development, firebase in production.
AUTH_MODE=firebase
# When true, require Firebase custom claim legal_reviewer=true.
AUTH_REQUIRE_LEGAL_REVIEWER=false
# Firebase project id for ID-token audience checks (falls back to FIRESTORE_PROJECT).
# FIREBASE_PROJECT_ID=script-clearance-hackathon
# Optional: service account JSON enables Firebase Admin SDK (not required for login).
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Clearance API (backend)
# Comma-separated frontend origins allowed by CORS. Do not use *.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:5174

# Upload / script limits
MAX_UPLOAD_SIZE_MB=20
MAX_PDF_PAGES=200
MAX_SCRIPT_CHARS=1000000

# Coarse IP limiter for costly POSTs (MVP only).
# After Firebase Auth, consider augmenting with per-user limits.
RATE_LIMIT_PER_MINUTE=30

# Persistence: auto (Firestore if credentials exist, else memory),
# memory, or firestore.
CLEARANCE_STORE=auto
FIRESTORE_PROJECT=script-clearance-hackathon
FIRESTORE_DATABASE=script-clearance-db

# Cloud Storage (for storing uploaded screenplay files)
# Create a bucket: gcloud storage buckets create gs://your-bucket-name --location=us-central1
GCS_BUCKET_NAME=script-clearance-scripts
# Optional: path to service account JSON key if not using default credentials
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Entity research cache (exact match) and semantic RAG (vector similarity)
RESEARCH_CACHE_ENABLED=true
RESEARCH_CACHE_BACKEND=auto
RESEARCH_CACHE_TTL_DAYS=30
RESEARCH_CACHE_MIN_CONFIDENCE=0.75
RESEARCH_RAG_ENABLED=true
RESEARCH_RAG_BACKEND=auto
RESEARCH_RAG_HIGH_SCORE=0.85
RESEARCH_RAG_MEDIUM_SCORE=0.72
RESEARCH_RAG_TOP_K=3
RESEARCH_EMBEDDING_MODEL=gemini-embedding-001
# gemini (production) or test (deterministic vectors for unit tests)
RESEARCH_EMBEDDING_BACKEND=gemini
RESEARCH_RAG_RERANK_ENABLED=true
RESEARCH_RAG_SYNTHESIS_ENABLED=true
# gemini (production) or test (no live LLM calls in unit tests)
RESEARCH_RAG_LLM_BACKEND=gemini
# Use Firestore find_nearest when vector index exists; falls back to scan
RESEARCH_RAG_FIRESTORE_NATIVE=true
