# Copy to .env and fill in real values. Do not commit .env.

GOOGLE_API_KEY=your-google-api-key
GEMINI_API_KEY=your-gemini-api-key
PARALLEL_API_KEY=your-parallel-api-key

# Max concurrent Gemini agent runs (specialists + risk scoring)
PIPELINE_CONCURRENCY=1
GEMINI_MODEL=gemini-3.6-flash

# Cloud Storage configuration (for storing uploaded screenplay files)
GCS_BUCKET_NAME=your-gcs-bucket-name

# Firestore configuration
FIRESTORE_PROJECT=your-gcp-project-id
FIRESTORE_DATABASE=your-firestore-database-id
FIREBASE_PROJECT_ID=your-firebase-project-id
AUTH_MODE=firebase

# Firebase Web (frontend + Cloud Build Secret Manager)
# Also copy VITE_* lines into frontend/.env for local Vite.
# setup-gcp.ps1 seeds VITE_FIREBASE_API_KEY into Secret Manager as FIREBASE_WEB_API_KEY.
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
