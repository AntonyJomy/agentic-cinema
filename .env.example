# Gemini / Google ADK (required)
# Get a key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-key-here
# ADK reads GOOGLE_API_KEY; if unset, agents bridge from GEMINI_API_KEY.
GOOGLE_API_KEY=your-key-here

# Parallel Search MCP (optional — higher rate limits; anonymous works)
# Get a key from https://platform.parallel.ai
PARALLEL_API_KEY=your-parallel-api-key-here

# Limit concurrent Gemini-heavy agent runs (specialists + risk scoring).
# Lower = fewer 503/high-demand errors; higher = faster runs.
# Default in code is 2 if unset.
PIPELINE_CONCURRENCY=1
# Legacy alias (used if PIPELINE_CONCURRENCY is unset):
# SPECIALIST_CONCURRENCY=2

# Gemini model for all agents (override if a model is overloaded).
# For newer AI Studio keys, Google currently requires gemini-3.6-flash.
GEMINI_MODEL=gemini-3.6-flash

# Runtime environment: development enables /docs; production disables it.
ENVIRONMENT=development

# Clearance API (backend)
# Comma-separated frontend origins allowed by CORS. Do not use *.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:5174

# Upload / script limits
MAX_UPLOAD_SIZE_MB=20
MAX_PDF_PAGES=200
MAX_SCRIPT_CHARS=1000000

# Coarse IP limiter for costly POSTs (MVP only).
# TODO(firebase-auth): replace/augment with per-user limits after Firebase Auth.
RATE_LIMIT_PER_MINUTE=30

# Persistence: auto (Firestore if credentials exist, else memory),
# memory, or firestore.
CLEARANCE_STORE=auto
FIRESTORE_PROJECT=script-clearance-hackathon
FIRESTORE_DATABASE=script-clearance-db
